# Copy to .env in the repository root. Use a local, non-production database.
MEDILINK_DB_NAME=medilink
MEDILINK_DB_HOST=localhost
MEDILINK_DB_PORT=5432
MEDILINK_DB_USER=postgres
MEDILINK_DB_PASSWORD=
MEDILINK_DB_CONNECT_TIMEOUT=5
MEDILINK_DB_STATEMENT_TIMEOUT_MS=5000
MEDILINK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private persistent document storage; relative paths are resolved from the repo.
MEDILINK_DOCUMENT_STORAGE_DIR=./var/documents
MEDILINK_DOCUMENT_MAX_BYTES=5242880
MEDILINK_DOCUMENT_MAX_IMAGE_PIXELS=20000000
MEDILINK_DOCUMENT_MAX_PDF_PAGES=100

# Optional operator-owned connection file; blank leaves all MCP servers unconfigured.
MEDILINK_MCP_CONFIG_FILE=

# Graph-owner HTTP facade (not the native NebulaGraph port); blank disables access.
MEDILINK_GRAPH_SERVICE_URL=
MEDILINK_GRAPH_SERVICE_TOKEN=
MEDILINK_GRAPH_TIMEOUT_SECONDS=10
MEDILINK_GRAPH_MAX_RESULTS=100

MEDILINK_MEDIUM_RISK_REVIEW=required
MEDILINK_APPROVAL_TTL_MINUTES=60
# Separate from access-token signing; shared only with trusted MCP action verifiers.
MEDILINK_ACTION_SIGNING_SECRET=

# Existing staff authentication; replace placeholders before running legacy login.
MEDILINK_JWT_SECRET=replace-with-a-random-secret
MEDILINK_ACCESS_TOKEN_MINUTES=60
MEDILINK_CARD_SECRET=replace-with-another-random-secret

# Existing AI configuration (not needed for the Part 1 foundation).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Integration-owner read-only durable action-receipt facade (Part 8).
MEDILINK_RECOVERY_SERVICE_URL=
MEDILINK_RECOVERY_SERVICE_TOKEN=
MEDILINK_RECOVERY_TIMEOUT_SECONDS=10
MEDILINK_RECONCILIATION_STALE_SECONDS=300
