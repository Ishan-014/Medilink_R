# Backend delivery configuration. Generate a NEW private .env with:
#   python -m backend.ops.init_env
# Existing .env files are never overwritten. No accounts are auto-provisioned.
# Native execution reads this root file; environment variables take precedence.
# Compose uses its private db:5432 and a persistent /app/var/documents volume.

# PostgreSQL: for native startup, create the database and match an existing role.
MEDILINK_DB_NAME=medilink
MEDILINK_DB_HOST=localhost
MEDILINK_DB_PORT=5432
MEDILINK_DB_USER=postgres
MEDILINK_DB_PASSWORD=
MEDILINK_DB_CONNECT_TIMEOUT=5
MEDILINK_DB_STATEMENT_TIMEOUT_MS=5000

# Authentication: separate random values, at least 32 characters each.
# Access JWT signs patient/staff access; card key signs staff QR payloads.
# Action key is shared only with trusted MCP write-context verifiers.
MEDILINK_JWT_SECRET=
MEDILINK_CARD_SECRET=
MEDILINK_ACTION_SIGNING_SECRET=
MEDILINK_ACCESS_TOKEN_MINUTES=60
MEDILINK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDILINK_API_PORT=8000

# Native document root (relative to the repo, or absolute); private, never public.
# Compose fixes its document root to /app/var/documents in a named volume.
MEDILINK_DOCUMENT_STORAGE_DIR=./var/documents
MEDILINK_DOCUMENT_MAX_BYTES=5242880
MEDILINK_DOCUMENT_MAX_IMAGE_PIXELS=20000000
MEDILINK_DOCUMENT_MAX_PDF_PAGES=100

# Hospital MCP configuration is operator-owned; blank disables all capabilities.
# In containers, use a CONTAINER path and an explicit read-only bind mount.
# HTTP bearer-token names and stdio env_vars are declared in that JSON file.
MEDILINK_MCP_CONFIG_FILE=

# Graph-owner HTTP facade, not the native NebulaGraph port. Blank disables it.
MEDILINK_GRAPH_SERVICE_URL=
MEDILINK_GRAPH_SERVICE_TOKEN=
MEDILINK_GRAPH_TIMEOUT_SECONDS=10
MEDILINK_GRAPH_MAX_RESULTS=100

# High risk always needs human review. Medium: required (default) or automatic.
MEDILINK_MEDIUM_RISK_REVIEW=required
MEDILINK_APPROVAL_TTL_MINUTES=60

# Integration-owner read-only durable action-receipt facade; blank disables it.
MEDILINK_RECOVERY_SERVICE_URL=
MEDILINK_RECOVERY_SERVICE_TOKEN=
MEDILINK_RECOVERY_TIMEOUT_SECONDS=10
MEDILINK_RECONCILIATION_STALE_SECONDS=300

# Optional legacy/AI-owner configuration. Unused by the backend-only entry point.
# These values are not forwarded to the backend Compose image.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Test/benchmark DSNs are intentionally NOT set here. Supply an explicit disposable
# MEDILINK_TEST_DB_DSN or MEDILINK_BENCHMARK_ADMIN_DSN for the documented commands.
